# 复制成 .env 后填入自己的密钥；.env 已被 .gitignore 忽略。
# 也可以直接用环境变量（环境变量优先于这个文件）。

# DeepSeek（promptkit 默认厂商）
DEEPSEEK_API_KEY=

# 豆包（DoubaoClient / 多模态）
DOUBAO_API_KEY=

# OpenAI（OpenAIClient / OpenAIEmbedding）
OPENAI_API_KEY=

# Anthropic（AnthropicClient）
ANTHROPIC_API_KEY=

# 通用网关密钥（走自定义 base_url 时用）
PROMPTKIT_API_KEY=

# SimpleTex OCR（examples/simpletex_*，用户授权令牌 UAT）
SIMPLETEX_TOKEN=
